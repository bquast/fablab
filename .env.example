# GEMINI_API_KEY: Required on the backend server for Silicon Copilot calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this full-stack applet is hosted (e.g. Cloud Run).
APP_URL="MY_APP_URL"

# VITE_COPILOT_API_URL: Optional backend origin when hosting the static frontend on GitHub Pages (gh-pages).
# Leave empty when running full-stack on port 3000 / Cloud Run so requests route to /api/copilot.
VITE_COPILOT_API_URL=""
